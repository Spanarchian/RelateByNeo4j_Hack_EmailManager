# Copy to .env and fill in. Placeholders only - never commit .env.

# --- Application ----------------------------------------------------------------
APP_ENV=development                 # development | test | production
LOG_LEVEL=INFO

# --- API authentication ---------------------------------------------------------
# JSON array of clients. Store only SHA-256 digests of keys.
# Generate with: uv run task api-key -- <name> <role[,role]> [human|service]
# Roles: submitter, reviewer, admin. Only human reviewers can approve/send.
API_KEYS=[{"name":"example.submitter","key_sha256":"<64-hex-sha256>","roles":["submitter"]},{"name":"example.reviewer","key_sha256":"<64-hex-sha256>","roles":["reviewer"]}]
APPROVAL_REQUIRE_FOUR_EYES=true
RATE_LIMIT_PER_MINUTE=120

# --- Relate by Neo4j (embedded) --------------------------------------------------
# Directory store (recommended: allows read-only inspection beside the app),
# a single-file store ending in .rl, or :memory: (not allowed in production).
RELATE_STORE_PATH=data/graph/onboarding

# --- Email ----------------------------------------------------------------------
EMAIL_PRIMARY_PROVIDER=gmail
EMAIL_SECONDARY_PROVIDER=mailchimp  # or: none
EMAIL_FAILOVER_ENABLED=true
EMAIL_DEFAULT_SENDER=onboarding@your-domain.example
EMAIL_ALLOWED_SENDERS=onboarding@your-domain.example
EMAIL_MAX_RECIPIENTS=20
PROVIDER_TIMEOUT_SECONDS=15
PROVIDER_MAX_RETRIES=2
PROVIDER_RETRY_BACKOFF_SECONDS=1.0

# --- Gmail (primary) -------------------------------------------------------------
# OAuth client (Desktop app) from Google Cloud Console; token created by `uv run task auth`.
GMAIL_CREDENTIALS_FILE=secrets/credentials.json
GMAIL_TOKEN_FILE=secrets/token.json

# --- Mailchimp Transactional (secondary) -----------------------------------------
# Leave empty to keep Mailchimp disabled.
MAILCHIMP_TRANSACTIONAL_API_KEY=
MAILCHIMP_FROM_NAME=
